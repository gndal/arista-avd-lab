---
extends: default

ignore: |
  # containerlab's per-lab runtime directory: generated by `containerlab
  # deploy`, gitignored, and not ours to lint.
  containerlab/clab-*/
  # Anything a CI job builds in the checkout.
  .venv/
  .lintvenv/
  collections/
  # Generated at runtime by playbooks/validate.yml.
  inventory/anta_inventory.generated.yml
  # AVD's own rendered output -- eos_designs formats these, not us.
  inventory/intended/

rules:
  line-length: disable
  document-start: disable
  truthy:
    allowed-values: ["true", "false"]
  # `labels: { role: spine, site: dc1 }` -- one space inside the braces is
  # normal flow-mapping style and reads better in the generated topology than
  # the zero-space form yamllint defaults to.
  braces:
    max-spaces-inside: 1
  # site_registry.yml aligns its one-line node mappings into columns, which
  # needs runs of spaces after a comma. The alignment is the point -- it makes
  # a mismatched mgmt IP or role visible at a glance.
  commas:
    max-spaces-after: -1
  comments:
    # AVD's rendered structured_configs and this repo's own generated files
    # use `#` comment banners without the two-space prefix yamllint wants.
    require-starting-space: true
    min-spaces-from-content: 1
  # The three settings below are required by ansible-lint, which refuses to
  # offer fix mode against a yamllint config that disagrees with it. Set to
  # exactly what it asks for so the two linters agree.
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true

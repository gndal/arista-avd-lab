{# Groups the registry's EOS nodes under the fabric, by avd_group, in registry order. #}
{% set groups = {} %}
{% for node in registry.nodes %}
{%   set _ = groups.setdefault(node.avd_group, []).append(node) %}
{% endfor %}
---
# GENERATED by playbooks/render_lab.yml from inventory/site_registry.yml.
# Do not hand-edit. Only the 8 EOS devices are here -- hosts/firewall are
# containerlab-managed, reached via `docker exec` (see
# playbooks/verify_dataplane.yml). BORDERLEAFS is a real Ansible child group
# of L3LEAFS, not an avd_group -- see docs/decisions.md.
all:
  children:
    {{ registry.lab.fabric }}:
      children:
{% for group, nodes in groups.items() %}
        {{ group }}:
          hosts:
{% for node in nodes if not (group == 'L3LEAFS' and node.role == 'borderleaf') %}
            {{ node.name }}:
              ansible_host: {{ node.mgmt }}
{% endfor %}
{% if group == 'L3LEAFS' %}
          children:
            BORDERLEAFS:
              hosts:
{% for node in nodes if node.role == 'borderleaf' %}
                {{ node.name }}:
                  ansible_host: {{ node.mgmt }}
{% endfor %}
{% endif %}
{% endfor %}

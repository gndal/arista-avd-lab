{# Generates containerlab/topology.clab.yml from inventory/site_registry.yml. #}
{# cEOS "EthernetN" maps to containerlab "ethN" -- hence the replace() below. #}
# GENERATED by playbooks/render_lab.yml from inventory/site_registry.yml.
# Do not hand-edit. See docs/LLD.md and docs/decisions.md.

name: {{ registry.lab.name }}

mgmt:
  network: {{ registry.mgmt.network }}
  ipv4-subnet: {{ registry.mgmt.subnet }}

topology:
  defaults:
    kind: ceos

  kinds:
    ceos:
      image: {{ registry.images.ceos }}
      startup-config: day0-ceos.cfg.tmpl
      enforce-startup-config: true
    linux:
      image: {{ registry.images.host }}

  nodes:
{% for node in registry.nodes %}
    {{ node.name }}:
      labels: { role: {{ node.role }} }
      mgmt-ipv4: {{ node.mgmt }}
      startup-delay: {{ registry.startup_delay_by_role[node.role] }}
{% endfor %}

    # Test hosts: LACP-bonded across the rack's leaf pair.
{% for host in registry.hosts %}
    {{ host.name }}:
      kind: linux
      labels: { role: host, tenant: {{ host.tenant }} }
      mgmt-ipv4: {{ host.mgmt }}
      startup-delay: {{ registry.startup_delay_by_role.host }}
      exec:
        # httpd lives in busybox-extras, not busybox, and must install
        # before the default route below moves off the mgmt bridge -- see
        # docs/troubleshooting.md.
        - apk add --no-cache iproute2 busybox-extras
        - ip link add bond0 type bond mode 802.3ad miimon 100
{% for att in host.attachments %}
        - ip link set eth{{ loop.index }} down
        - ip link set eth{{ loop.index }} master bond0
{% endfor %}
        - ip link set bond0 up
{% for att in host.attachments %}
        - ip link set eth{{ loop.index }} up
{% endfor %}
        - ip addr add {{ host.ip }} dev bond0
        - ip route replace default via {{ host.gateway }} dev bond0
        - sh -c 'echo {{ host.name }} > /tmp/index.html'
        - httpd -p 8080 -h /tmp
{% endfor %}

    # Inter-VRF firewall: no VRFs of its own, nftables decides what crosses.
    {{ registry.firewall.name }}:
      kind: linux
      image: {{ registry.images.firewall }}
      labels: { role: firewall }
      mgmt-ipv4: {{ registry.firewall.mgmt }}
      startup-delay: {{ registry.startup_delay_by_role.firewall }}
      binds:
        - frr-firewall/frr.conf:/etc/frr/frr.conf:ro
        - frr-firewall/daemons:/etc/frr/daemons:ro
        - frr-firewall/nftables.conf:/etc/nftables.conf:ro
      exec:
{% for up in registry.firewall.uplinks %}
{% set eth_idx = loop.index %}
        - ip link set eth{{ eth_idx }} up
{% for sub in up.subinterfaces %}
        - ip link add link eth{{ eth_idx }} name eth{{ eth_idx }}.{{ sub.tag }} type vlan id {{ sub.tag }}
        - ip addr add {{ sub.local }} dev eth{{ eth_idx }}.{{ sub.tag }}
        - ip link set eth{{ eth_idx }}.{{ sub.tag }} up
{% endfor %}
{% endfor %}

  links:
    # Underlay: every l3leaf to both spines.
{% for node in registry.nodes if node.uplinks is defined %}
{% for up in node.uplinks %}
    - endpoints: ["{{ node.name }}:eth{{ loop.index }}", "{{ up.peer }}:{{ up.peer_port | replace('Ethernet', 'eth') }}"]
{% endfor %}
{% endfor %}

    # Test hosts: one link per leaf in the pair, bonded on the host side.
{% for host in registry.hosts %}
{% for att in host.attachments %}
    - endpoints: ["{{ att.peer }}:{{ att.peer_port | replace('Ethernet', 'eth') }}", "{{ host.name }}:eth{{ loop.index }}"]
{% endfor %}
{% endfor %}

    # Firewall uplink(s) -- currently one (single-homed), see docs/decisions.md.
{% for up in registry.firewall.uplinks %}
    - endpoints: ["{{ up.peer }}:{{ up.peer_port | replace('Ethernet', 'eth') }}", "{{ registry.firewall.name }}:eth{{ loop.index }}"]
{% endfor %}
